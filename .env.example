NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel's Supabase integration may provide these legacy aliases instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sports provider: sportsdataio or demo
SPORTS_PROVIDER=demo
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io/v3/nfl

# Protect commissioner sync/grade endpoints if calling from cron.
CRON_SECRET=

# LiveKit (optional; enables in-app live broadcast)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Optional override if your SportsDataIO subscription uses another player endpoint.
SPORTSDATAIO_PLAYERS_PATH=/scores/json/Players

# Private code used only to promote your own beta account to commissioner.
BETA_COMMISSIONER_CODE=
